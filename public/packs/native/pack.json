      "clipId": "kinetic-title",
      "license": "MIT (native ClipKit component; embedded source assets retain their licenses)",
      "defaults": {
        "easing": "ease-out",
        "text": "Ideas into\nimpact.",
        "color": "#c7f36b",
        "size": 102,
        "x": 0,
        "y": 0,
        "opacity": 1,
        "revealDuration": 0.65,
        "scale": 1,
        "width": 600,
        "subtitle": "Small steps. Extraordinary stories.",
        "background": "#142b26"

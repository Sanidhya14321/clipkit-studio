{
  "format": "clipkit.asset-pack/v1",
  "id": "clipkit-native",
  "version": "1.1.0",
  "license": "MIT",
  "runtime": {
    "kind": "compiled",
    "registry": "clipkit/native-v1"
  },
  "editableContract": {
    "layerAttribute": "data-ck-layer",
    "propertyAttribute": "data-ck-path",
    "elementAttribute": "data-ck-element",
    "requiredProps": [
      "text",
      "color",
      "size",
      "x",
      "y",
      "opacity",
      "revealDuration"
    ]
  },

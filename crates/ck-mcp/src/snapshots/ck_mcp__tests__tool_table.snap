  {
    "name": "recipe_apply",
    "command": "ck recipe apply",
    "description": "Fill a recipe's slots: adds its named layers (tokens, provenance, briefDeps) as one revision. Returns the layer ids.",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "default": 0.0,
          "description": "Scene start in seconds.",
          "format": "double",
          "type": "number"
        },
        "duration": {
          "description": "Scene duration in seconds; the recipe default when omitted.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "look": {
          "description": "Look id whose tokens the layers use; defaults to the project look (`look apply`), then\nthe brief's look, then `clean-product`.",
          "type": [
            "string",
            "null"
          ]
        },
        "prefix": {
          "description": "Layer id prefix; layer ids are `<prefix>-<layer name>`. Defaults to the recipe id, with\n`-2`, `-3` ... added when that is taken.",
          "type": [
            "string",
            "null"
          ]
        },
        "recipe": {
          "description": "Recipe id (from `recipe search`).",
          "type": "string"
        },
        "slots": {
          "additionalProperties": true,
          "default": {},
          "description": "Slot name to value (text, number, list of text, or a source id).",
          "type": "object"
        }
      },
      "required": [
        "recipe"
      ],
      "type": "object"
    }
  },
  {
    "name": "layout_check",
    "command": "ck layout check",
    "description": "Check the text layers against the layout rules (safe area, overlap, gap, grid, size, cut text, at most 3 blocks) for the brief's platform. Returns the issues.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "description": "`status` takes no input.",
      "type": "object"
    }
  },
  {
    "name": "verify",

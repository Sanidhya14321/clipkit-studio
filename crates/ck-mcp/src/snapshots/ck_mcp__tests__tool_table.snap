        }
      },
      "properties": {
        "holder": {
          "$ref": "#/$defs/Holder"
        },
        "layerIds": {
          "description": "Layers to release; omitted means every lock of the holder.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "holder"
      ],
      "type": "object"
    }
  },
  {
    "name": "heartbeat",
    "command": "ck heartbeat",
    "description": "Renew the holder's live locks so they do not expire; returns them.",
    "cap": 4096,
    "inputSchema": {
      "$defs": {
        "Holder": {
          "enum": [

          },
          "type": "array"
        }
      },
      "required": [
        "holder",
        "layerIds"
      ],
      "type": "object"
    }
  },
  {
    "name": "unlock",
    "command": "ck unlock",
    "description": "Release layers (all of the holder's locks when layerIds is omitted).",
    "cap": 4096,
    "inputSchema": {
      "$defs": {
        "Holder": {
          "enum": [

---
source: crates/ck-mcp/src/tests.rs
expression: specs()
---
[
  {
    "name": "studio",
    "command": "ck studio",
    "description": "Start the studio in the background unless it is running (ck studio --ensure); `open` opens its browser tab once.",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "description": "Open the studio in the browser, once per server.",
          "type": "boolean",
          "default": false
        }
      },
      "description": "`studio` (MCP) / `ck studio --ensure` input.",
      "type": "object"
    }
  },
  {
    "name": "status",
    "command": "ck status",
    "description": "Project rev, mode, pipeline stage, agent state and live locks.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "project_get",
    "command": "ck project get",
    "description": "The project summary (ids, kinds and spans per track), or one layer in full with `layer`.",
    "cap": 16384,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "description": "Ids, kinds and spans per track (the default).",
          "type": "boolean",
          "default": false
        },
        "layer": {
          "description": "One layer by id.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "`project get`: the summary (default) or one layer in full.",
      "type": "object"
    }
  },
  {
    "name": "project_patch",
    "command": "ck project patch",
    "description": "Apply an RFC 6902 patch at baseRev. Lock the layers first.",
    "cap": 4096,
    "inputSchema": {
      "$defs": {
        "Patch": {
          "description": "Representation of JSON Patch (list of patch operations)",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatchOperation"
          }
        },
        "PatchOperation": {
          "description": "JSON Patch single patch operation",
          "oneOf": [
            {
              "description": "'add' operation",
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "add"
                }
              },
              "$ref": "#/$defs/AddOperation",
              "required": [
                "op"
              ]
            },
            {
              "description": "'remove' operation",
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "remove"
                }
              },
              "$ref": "#/$defs/RemoveOperation",
              "required": [
                "op"
              ]
            },
            {
              "description": "'replace' operation",
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "replace"
                }
              },
              "$ref": "#/$defs/ReplaceOperation",
              "required": [
                "op"
              ]
            },
            {
              "description": "'move' operation",
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "move"
                }
              },
              "$ref": "#/$defs/MoveOperation",
              "required": [
                "op"
              ]
            },
            {
              "description": "'copy' operation",
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "copy"
                }
              },
              "$ref": "#/$defs/CopyOperation",
              "required": [
                "op"
              ]
            },
            {
              "description": "'test' operation",
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "test"
                }
              },
              "$ref": "#/$defs/TestOperation",
              "required": [
                "op"
              ]
            }
          ]
        },
        "AddOperation": {
          "description": "JSON Patch 'add' operation representation",
          "type": "object",
          "properties": {
            "path": {
              "description": "JSON-Pointer value [RFC6901](https://tools.ietf.org/html/rfc6901) that references a location\nwithin the target document where the operation is performed.",
              "type": "string"
            },
            "value": {
              "description": "Value to add to the target location."
            }
          },
          "required": [
            "path",
            "value"
          ]
        },
        "RemoveOperation": {
          "description": "JSON Patch 'remove' operation representation",
          "type": "object",
          "properties": {
            "path": {
              "description": "JSON-Pointer value [RFC6901](https://tools.ietf.org/html/rfc6901) that references a location\nwithin the target document where the operation is performed.",
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        "ReplaceOperation": {
          "description": "JSON Patch 'replace' operation representation",
          "type": "object",
          "properties": {
            "path": {
              "description": "JSON-Pointer value [RFC6901](https://tools.ietf.org/html/rfc6901) that references a location\nwithin the target document where the operation is performed.",
              "type": "string"
            },
            "value": {
              "description": "Value to replace with."
            }
          },
          "required": [
            "path",
            "value"
          ]
        },
        "MoveOperation": {
          "description": "JSON Patch 'move' operation representation",
          "type": "object",
          "properties": {
            "from": {
              "description": "JSON-Pointer value [RFC6901](https://tools.ietf.org/html/rfc6901) that references a location\nto move value from.",
              "type": "string"
            },
            "path": {
              "description": "JSON-Pointer value [RFC6901](https://tools.ietf.org/html/rfc6901) that references a location\nwithin the target document where the operation is performed.",
              "type": "string"
            }
          },
          "required": [
            "from",
            "path"
          ]
        },
        "CopyOperation": {
          "description": "JSON Patch 'copy' operation representation",
          "type": "object",
          "properties": {
            "from": {
              "description": "JSON-Pointer value [RFC6901](https://tools.ietf.org/html/rfc6901) that references a location\nto copy value from.",
              "type": "string"
            },
            "path": {
              "description": "JSON-Pointer value [RFC6901](https://tools.ietf.org/html/rfc6901) that references a location\nwithin the target document where the operation is performed.",
              "type": "string"
            }
          },
          "required": [
            "from",
            "path"
          ]
        },
        "TestOperation": {
          "description": "JSON Patch 'test' operation representation",
          "type": "object",
          "properties": {
            "path": {
              "description": "JSON-Pointer value [RFC6901](https://tools.ietf.org/html/rfc6901) that references a location\nwithin the target document where the operation is performed.",
              "type": "string"
            },
            "value": {
              "description": "Value to test against."
            }
          },
          "required": [
            "path",
            "value"
          ]
        },
        "Author": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "voice"
          ]
        }
      },
      "required": [
        "baseRev",
        "ops",
        "author"
      ],
      "type": "object",
      "properties": {
        "baseRev": {
          "description": "The project revision the patch was built against.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "layerRevs": {
          "description": "Optional per-layer revisions the caller read; any mismatch makes the patch stale.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "ops": {
          "$ref": "#/$defs/Patch"
        },
        "author": {
          "$ref": "#/$defs/Author"
        },
        "label": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  {
    "name": "lock",
    "command": "ck lock",
    "description": "Lock layers before touching them; returns the holder's live locks.",
    "cap": 4096,
    "inputSchema": {
      "$defs": {
        "Holder": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        }
      },
      "required": [
        "holder",
        "layerIds"
      ],
      "type": "object",
      "properties": {
        "holder": {
          "$ref": "#/$defs/Holder"
        },
        "layerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "unlock",
    "command": "ck unlock",
    "description": "Release layers (all of the holder's locks when layerIds is omitted).",
    "cap": 4096,
    "inputSchema": {
      "$defs": {
        "Holder": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        }
      },
      "required": [
        "holder"
      ],
      "type": "object",
      "properties": {
        "holder": {
          "$ref": "#/$defs/Holder"
        },
        "layerIds": {
          "description": "Layers to release; omitted means every lock of the holder.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "heartbeat",
    "command": "ck heartbeat",
    "description": "Renew the holder's live locks so they do not expire; returns them.",
    "cap": 4096,
    "inputSchema": {
      "$defs": {
        "Holder": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        }
      },
      "required": [
        "holder"
      ],
      "type": "object",
      "properties": {
        "holder": {
          "$ref": "#/$defs/Holder"
        }
      }
    }
  },
  {
    "name": "brief_propose",
    "command": "ck brief propose",
    "description": "Send inferred brief values only (and at most 3 questions, each naming what it affects); the studio shows the Brief page. Then call brief_wait.",
    "cap": 1024,
    "inputSchema": {
      "$defs": {
        "BriefQuestion": {
          "description": "A question the agent adds to the brief, stating which fields its answer affects.",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "affects": {
              "description": "Brief fields or parts of the video the answer changes (never empty).",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "answer": {
              "description": "The user's answer, once given."
            }
          },
          "required": [
            "id",
            "text",
            "affects"
          ]
        }
      },
      "required": [
        "fields"
      ],
      "description": "`brief propose`: inferred values only. Fields the user already set are kept as they are.",
      "type": "object",
      "properties": {
        "fields": {
          "description": "Field name (goal, cta, audience, platform, aspect, length, pacing, look, voice, ...) to\nthe inferred value.",
          "type": "object",
          "additionalProperties": true
        },
        "confidence": {
          "description": "Optional confidence (0 to 1) per field; 0.5 when omitted.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "questions": {
          "description": "At most three dynamic questions, each naming what it affects.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BriefQuestion"
          }
        },
        "auto": {
          "description": "The user asked for no questions or autopilot is on: mark the brief auto, so planning can\nstart; the studio shows it afterwards as an editable card.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "brief_wait",
    "command": "ck brief wait",
    "description": "Block until the user confirms the brief (or it is auto), at most 25 s; call again while ready is false. Returns the confirmed brief.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "timeoutSecs": {
          "description": "Seconds to block (default 20, at most 25); 0 checks once.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "type": "object"
    }
  },
  {
    "name": "brief_diff",
    "command": "ck brief diff",
    "description": "Only what changed in the brief since a rev you read; patch only layers whose briefDeps changed.",
    "cap": 4096,
    "inputSchema": {
      "required": [
        "since"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "since": {
          "description": "The rev of the brief the agent last read (from `brief get` or `brief wait`).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      }
    }
  },
  {
    "name": "brief_get",
    "command": "ck brief get",
    "description": "The brief in compact form (value and source per field) with its rev.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "taste_search",
    "command": "ck taste search",
    "description": "Rank the taste files by query words (id, title, tags); read at most 3 of them.",
    "cap": 2048,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "description": "Words to look for in ids, titles, tags and bodies; empty lists every file.",
          "type": "string",
          "default": ""
        },
        "limit": {
          "description": "Most hits to return (default 5, at most 12).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "type": "object"
    }
  },
  {
    "name": "taste_read",
    "command": "ck taste read",
    "description": "One taste file in full: direction with concrete numbers.",
    "cap": 3072,
    "inputSchema": {
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "look_list",
    "command": "ck look list",
    "description": "The looks in short: id, name, description and motion personality.",
    "cap": 2048,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    }
  },
  {
    "name": "look_get",
    "command": "ck look get",
    "description": "One look with all its design tokens (colors, fonts, type scale, motion).",
    "cap": 2048,
    "inputSchema": {
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "recipe_search",
    "command": "ck recipe search",
    "description": "Rank the recipes by query words; each hit lists its slots (name*:kind<=chars). Prefer a recipe over hand-built layers when one fits.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "description": "Words to look for in ids, names, tags and use-when lines; empty lists every recipe.",
          "type": "string",
          "default": ""
        },
        "limit": {
          "description": "Most hits to return (default 5, at most 12).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "type": "object"
    }
  },
  {
    "name": "recipe_card",
    "command": "ck recipe card",
    "description": "One recipe in full: slots, layers and props.",
    "cap": 6144,
    "inputSchema": {
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "sources_list",
    "command": "ck sources list",
    "description": "The Source Hub registry, one line per source: id, status, enabled, license class, kind, repo. Only vetted and enabled sources are searchable.",
    "cap": 6144,
    "inputSchema": {
      "$defs": {
        "SourceStatus": {
          "description": "Vetting status of a source.",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "unverified"
              ]
            },
            {
              "description": "Vetting ran and passed; the license was read from the source.",
              "type": "string",
              "const": "vetted"
            },
            {
              "description": "Vetting ran and found a blocker.",
              "type": "string",
              "const": "rejected"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "status": {
          "description": "Only sources with this status.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  {
    "name": "sources_add",
    "command": "ck sources add",
    "description": "Register a source (unverified, disabled, license unknown until vetted). Never guess a repo: leave it out when unknown.",
    "cap": 1024,
    "inputSchema": {
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "description": "Lowercase id: letters, digits and dashes.",
          "type": "string"
        },
        "name": {
          "type": "string",
          "default": ""
        },
        "kind": {
          "type": "string"
        },
        "repo": {
          "description": "`owner/name` on GitHub, when known (never guessed).",
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "description": "The license the listing claims (recorded as a claim, not a finding).",
          "type": "string",
          "default": ""
        }
      }
    }
  },
  {
    "name": "sources_vet",
    "command": "ck sources vet",
    "description": "Vet a source without running its code: shallow read-only fetch into quarantine (or `from` a local folder), license read from its text, malware-lure and dependency checks. Pass: vetted and enabled; blocker: rejected; unknown license: stays unverified. Pins the result in sources.lock.",
    "cap": 4096,
    "inputSchema": {
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "description": "Vet a local folder instead of cloning the repo (fixtures, manual downloads).",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  {
    "name": "assets_search",
    "command": "ck assets search",
    "description": "Retrieval ladder step 1: top 5 compact lines (id kind grade licenseClass: use when) from vetted sources, filtered by kind, tag, aspect, grade, collection and the license mode (default the brief's, else commercial-safe).",
    "cap": 2048,
    "inputSchema": {
      "$defs": {
        "AssetKind": {
          "description": "What an asset is.",
          "type": "string",
          "enum": [
            "remotion-clip",
            "react-component",
            "css-effect",
            "shader",
            "lottie",
            "lut",
            "overlay-video",
            "sfx",
            "music",
            "font",
            "icon",
            "ae-reference",
            "premiere-reference"
          ]
        },
        "LicenseMode": {
          "description": "License mode (spec 7.6): a brief field that search, recipes and export respect.",
          "type": "string",
          "enum": [
            "commercial-safe",
            "personal",
            "any"
          ]
        },
        "Grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "default": ""
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "aspect": {
          "description": "For example `9:16`; assets with no aspects listed match any.",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "description": "Default: the brief's licenseMode, else commercial-safe.",
          "anyOf": [
            {
              "$ref": "#/$defs/LicenseMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "grade": {
          "description": "Lowest grade accepted (A is best).",
          "anyOf": [
            {
              "$ref": "#/$defs/Grade"
            },
            {
              "type": "null"
            }
          ]
        },
        "collection": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "At most 5.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      }
    }
  },
  {
    "name": "assets_card",
    "command": "ck assets card",
    "description": "Step 2: one asset card. At most 2 distinct cards per decision (E_BUDGET after).",
    "cap": 3072,
    "inputSchema": {
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "assets_skeleton",
    "command": "ck assets skeleton",
    "description": "Step 3: props, animation primitives, imports and the outline with line ranges (about 600 tokens).",
    "cap": 2656,
    "inputSchema": {
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "assets_slice",
    "command": "ck assets slice",
    "description": "Step 4: one symbol's source from the outline (about 800 tokens).",
    "cap": 3456,
    "inputSchema": {
      "required": [
        "id",
        "symbol"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "symbol": {
          "description": "Symbol name from the skeleton's outline.",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "assets_source",
    "command": "ck assets source",
    "description": "Step 5: the full source, only with a one-line reason; once per decision.",
    "cap": 16384,
    "inputSchema": {
      "required": [
        "id",
        "reason"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "description": "Why the card, skeleton and slice are not enough (one line, at least 10 characters).",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "license_report",
    "command": "ck license report",
    "description": "Every asset the project uses with license, SPDX, class, attribution line and notes, checked against the license mode; ClipKit originals and the Remotion runtime license listed apart. ok=false means a blocked or unresolved asset.",
    "cap": 8192,
    "inputSchema": {
      "$defs": {
        "LicenseMode": {
          "description": "License mode (spec 7.6): a brief field that search, recipes and export respect.",
          "type": "string",
          "enum": [
            "commercial-safe",
            "personal",
            "any"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "mode": {
          "description": "Check against this mode instead of the brief's.",
          "anyOf": [
            {
              "$ref": "#/$defs/LicenseMode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  {
    "name": "eval",
    "command": "ck eval",
    "description": "Score an exported video from the file alone: duration, aspect, loudness, clipping, black and frozen frames, cut accuracy against expected cuts, sources unchanged. OCR checks are listed as not measured.",
    "cap": 4096,
    "inputSchema": {
      "$defs": {
        "Expectations": {
          "type": "object",
          "properties": {
            "durationSec": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "durationTolerance": {
              "description": "Allowed difference, seconds (default 0.5).",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "aspect": {
              "description": "For example `16:9` or `9:16`.",
              "type": [
                "string",
                "null"
              ]
            },
            "loudness": {
              "description": "Default -14 LUFS and -1 dBTP.",
              "anyOf": [
                {
                  "$ref": "#/$defs/LoudnessTarget"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cutsAtSec": {
              "description": "Expected hard cuts in the output, seconds (ground truth).",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "default": []
            },
            "cutTolerance": {
              "description": "Default 0.1 s.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "sources": {
              "description": "Source files that must be unchanged: path and SHA-256.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceHash"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "LoudnessTarget": {
          "type": "object",
          "properties": {
            "integrated": {
              "description": "Integrated loudness, LUFS.",
              "type": "number",
              "format": "double"
            },
            "truePeak": {
              "description": "Maximum true peak, dBTP.",
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "integrated",
            "truePeak"
          ]
        },
        "SourceHash": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "hash": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "hash"
          ]
        }
      },
      "required": [
        "video"
      ],
      "type": "object",
      "properties": {
        "video": {
          "description": "The exported video.",
          "type": "string"
        },
        "expect": {
          "$ref": "#/$defs/Expectations",
          "default": {
            "cutsAtSec": [],
            "sources": []
          }
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "replay",
    "command": "ck replay",
    "description": "Rebuild the project from its stored patches without an agent; reproduces=false means history and project disagree. `to` also rebuilds an earlier revision.",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "to": {
          "description": "Also rebuild the content at this earlier revision.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "type": "object"
    }
  },
  {
    "name": "bisect",
    "command": "ck bisect",
    "description": "Find the first revision where the quality gates (or one `gate`) fail, by binary search over history; returns its label and failing gates.",
    "cap": 2048,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "description": "Only this gate (for example `overlaps`); default any gate.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "trace_bundle",
    "command": "ck trace bundle",
    "description": "Write one redacted, shareable JSON trace (environment, project, history, failing gates, replay status) under .clipkit/traces/.",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    }
  },
  {
    "name": "demo_reset",
    "command": "ck demo reset",
    "description": "Restore the seeded demo project (brief, three scenes, voice script, a comment) in this folder; refuses a non-demo project without force and while a studio runs.",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "force": {
          "description": "Replace a project that is not the demo.",
          "type": "boolean",
          "default": false
        }
      },
      "type": "object"
    }
  },
  {
    "name": "bench_report",
    "command": "ck bench report",
    "description": "Medians, ranges and pass rates per arm and scenario from bench run lines; tokens only from the agents' own usage (otherwise not measured).",
    "cap": 16384,
    "inputSchema": {
      "required": [
        "results"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "results": {
          "description": "The results file (one JSON run per line).",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "profile",
    "command": "ck profile",
    "description": "The local taste profile learned from the user's picks: show its defaults, or clear, disable or enable it. It fills brief fields nobody set; never overrides.",
    "cap": 2048,
    "inputSchema": {
      "$defs": {
        "ProfileAction": {
          "description": "What `ck profile` does.",
          "type": "string",
          "enum": [
            "show",
            "clear",
            "disable",
            "enable"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ProfileAction",
          "default": "show"
        }
      }
    }
  },
  {
    "name": "sources_ingest",
    "command": "ck sources ingest",
    "description": "Turn a vetted source into cards: each exported component gets asset.md, ast.json and a read-only copy of its file (parsing only, nothing runs); rebuilds the catalog. Owner notes are kept.",
    "cap": 4096,
    "inputSchema": {
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "sources_gaps",
    "command": "ck sources gaps",
    "description": "What the catalog is missing: usable and unverified source counts, sources without a repo, asset kinds with no searchable card.",
    "cap": 2048,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    }
  },
  {
    "name": "look_apply",
    "command": "ck look apply",
    "description": "Re-theme the project with a look: one write, layers keep their token refs. Returns the previous look and the layers that change; dryRun only previews.",
    "cap": 2048,
    "inputSchema": {
      "required": [
        "look"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "look": {
          "description": "Look id (from `look list`).",
          "type": "string"
        },
        "dryRun": {
          "description": "Only preview the impact; write nothing.",
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  {
    "name": "recipe_apply",
    "command": "ck recipe apply",
    "description": "Fill a recipe's slots: adds its named layers (tokens, provenance, briefDeps) as one revision. Returns the layer ids.",
    "cap": 1024,
    "inputSchema": {
      "$defs": {
        "PlaceMode": {
          "description": "Where a scene goes relative to existing layers.",
          "oneOf": [
            {
              "description": "Layers on top; nothing moves.",
              "type": "string",
              "const": "overlay"
            },
            {
              "description": "Every later layer moves by the scene's full length.",
              "type": "string",
              "const": "insert"
            },
            {
              "description": "Later layers move only as far as needed to clear the scene.",
              "type": "string",
              "const": "ripple"
            }
          ]
        }
      },
      "required": [
        "recipe"
      ],
      "type": "object",
      "properties": {
        "recipe": {
          "description": "Recipe id (from `recipe search`).",
          "type": "string"
        },
        "at": {
          "description": "Scene start in seconds.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "dur": {
          "description": "Scene duration in seconds; the recipe default when omitted.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "place": {
          "description": "How the scene meets what is already at `at` (default overlay).",
          "$ref": "#/$defs/PlaceMode"
        },
        "slots": {
          "description": "Slot name to value (text, number, list of text, or a source id).",
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "prefix": {
          "description": "Layer id prefix; layer ids are `<prefix>-<layer name>`. Defaults to the recipe id, with\n`-2`, `-3` ... added when that is taken.",
          "type": [
            "string",
            "null"
          ]
        },
        "look": {
          "description": "Look id whose tokens the layers use; defaults to the project look (`look apply`), then\nthe brief's look, then `clean-product`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "layout_check",
    "command": "ck layout check",
    "description": "Check the text layers against the layout rules (safe area, overlap, gap, grid, size, cut text, at most 3 blocks) for the brief's platform. Returns the issues.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "verify",
    "command": "ck verify",
    "description": "Run the quality gates (schema, gaps, overlaps, duration, layout, contrast, fonts, motion, reuse, provenance, placeholders). Returns passed and failed gates and the issues; fix failures before the next pass. critic=true also renders the contact sheet for the clipkit-critic subagent (once per pass, when gates are uncertain).",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "critic": {
          "description": "Also render the critic's contact sheet (6 low-resolution frames at cuts and motion\npeaks). Once per pass, when the gates are uncertain.",
          "type": "boolean",
          "default": false
        }
      },
      "type": "object"
    }
  },
  {
    "name": "sound_plan",
    "command": "ck sound plan",
    "description": "Plan sound design for the audio pass: whooshes just before cuts, hits on text landings, risers before hooks, room tone under cuts, duck cues for music under voice. Read-only; returns timed cues.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "doctor",
    "command": "ck doctor",
    "description": "Check this machine: tools, render worker and keys set (values never shown), with a fix line for each problem.",
    "cap": 2048,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "content_map",
    "command": "ck content map",
    "description": "Compact content map of a transcribed source: numbered phrases, hook, fillers, retakes and pauses. Read this, not the transcript; phrase i spans anchors i to i+1.",
    "cap": 6144,
    "inputSchema": {
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "source": {
          "description": "Source id (from `import`).",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "grid_build",
    "command": "ck grid build",
    "description": "Build the rhythm grid in plan.edl: speech from source, beats from music, else a generated grid from the brief's pace (fast by default).",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Source whose speech sets the rhythm.",
          "type": [
            "string",
            "null"
          ]
        },
        "music": {
          "description": "Audio source whose beats are measured.",
          "type": [
            "string",
            "null"
          ]
        },
        "bpm": {
          "description": "Tempo of a generated grid; from the brief's pacing when omitted.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "dur": {
          "description": "Length of a generated grid in seconds; default 30.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "plan_get",
    "command": "ck plan get",
    "description": "Read plan.edl: stored segments and a grid summary.",
    "cap": 8192,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "plan_set",
    "command": "ck plan set",
    "description": "Replace plan.edl segments. Segments use grid anchor indices, never raw times.",
    "cap": 1024,
    "inputSchema": {
      "$defs": {
        "Segment": {
          "description": "One decision of the agent.",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "from": {
              "description": "First anchor index.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "to": {
              "description": "Anchor index where the segment ends; after `from`.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "role": {
              "$ref": "#/$defs/Role"
            },
            "recipe": {
              "description": "Recipe drawn over the segment.",
              "type": [
                "string",
                "null"
              ]
            },
            "slots": {
              "description": "Recipe slot values.",
              "type": "object",
              "additionalProperties": true
            },
            "source": {
              "description": "Source id whose speech this keeps; anchors are then that source's times.",
              "type": [
                "string",
                "null"
              ]
            },
            "transition": {
              "description": "Transition into the next segment (recorded; at most two types per plan).",
              "type": [
                "string",
                "null"
              ]
            },
            "captions": {
              "description": "Draw captions from the kept words.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "from",
            "to",
            "role"
          ]
        },
        "Role": {
          "type": "string",
          "enum": [
            "hook",
            "point",
            "proof",
            "turn",
            "cta"
          ]
        }
      },
      "required": [
        "segments"
      ],
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Segment"
          }
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plan_candidates",
    "command": "ck plan candidates",
    "description": "Top 3 recipes per segment, one line each; pick one and set it in the segment.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "plan_expand",
    "command": "ck plan expand",
    "description": "Expand segments into layers on exact frames, with captions from kept words. Name a segment to change only that segment.",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "segment": {
          "description": "Only this segment; default all.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "pipeline_detect",
    "command": "ck pipeline detect",
    "description": "Read the mode from the project's sources and open the brief stage. First step of every job.",
    "cap": 512,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "pipeline_next",
    "command": "ck pipeline next",
    "description": "Finish the current pass or step and move to the next. Passes run in order: structure, audio, text, graphics, transitions, look, polish, then verify.",
    "cap": 512,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "handoff",
    "command": "ck handoff",
    "description": "Hand the project to the user: release every agent lock and set the agent idle. Then reply in five lines or fewer and loop on wait with since = the returned rev.",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "What the studio shows for the agent while idle (default \"Waiting for you\").",
          "type": [
            "string",
            "null"
          ]
        },
        "overrideReason": {
          "description": "Why the agent hands off with failing gates; shown to the user in the studio.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "import",
    "command": "ck import",
    "description": "Import a media file by absolute path: probe, hash, 720p proxy and 48 kHz audio into the cache, then register it as a project source. Same content twice returns the existing source.",
    "cap": 1024,
    "inputSchema": {
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "path": {
          "description": "Absolute path of the media file.",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "transcribe",
    "command": "ck transcribe",
    "description": "Transcribe an imported source with word timestamps; the transcript stays on disk (read it with transcript_get).",
    "cap": 1024,
    "inputSchema": {
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "source": {
          "description": "Source id (from `import`).",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "transcript_get",
    "command": "ck transcript get",
    "description": "The packed transcript of a source: one line per phrase (#firstWord start-end text, fillers in parentheses) or silence (~ start-end silence).",
    "cap": 16384,
    "inputSchema": {
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "source": {
          "description": "Source id (from `import`).",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "cut_suggest",
    "command": "ck cut suggest",
    "description": "Cut candidates for a source (silence, filler, retake) on word boundaries with confidence, plus scene changes. Apply with cut_apply.",
    "cap": 8192,
    "inputSchema": {
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "source": {
          "description": "Source id (from `import`).",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "cut_apply",
    "command": "ck cut apply",
    "description": "Apply suggested cuts (ids, or all when empty): the source's footage on the video track becomes the kept segments, end to end, as one revision.",
    "cap": 2048,
    "inputSchema": {
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "ids": {
          "description": "Cut ids from `cut suggest`; empty applies every suggested cut.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    }
  },
  {
    "name": "assets_derive",
    "command": "ck assets derive",
    "description": "Adaptation rung 3: a project-local copy of an asset with colours lifted into tokens, data-ck-layer instrumentation and a props schema; provenance recorded and the asset added to assetsUsed. Refused when the license mode does not allow it.",
    "cap": 2048,
    "inputSchema": {
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "description": "Asset id from `assets search`.",
          "type": "string"
        },
        "name": {
          "description": "Folder name for the copy (lowercase, digits, dashes).",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "render_check",
    "command": "ck render check",
    "description": "Determinism test: renders frames (default first, middle, last) in order and again in reverse through the render worker and compares them. deterministic=false lists the unstable frames (time- or random-dependent layers).",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "frames": {
          "description": "Frames to check; default first, middle and last.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "default": []
        }
      },
      "type": "object"
    }
  },
  {
    "name": "music_analyze",
    "command": "ck music analyze",
    "description": "Bounded audio onset/tempo candidates; full data cached; no timing or license approval.",
    "cap": 4096,
    "inputSchema": {
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "reference_analyze",
    "command": "ck reference analyze",
    "description": "Statistics of a reference video only (duration, aspect, shot lengths, cuts per 15 s, loudness) and suggested brief fields; apply=true writes them with source reference, keeping fields the user set.",
    "cap": 1024,
    "inputSchema": {
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "path": {
          "description": "Path of the reference video (absolute, or relative to the project folder).",
          "type": "string"
        },
        "apply": {
          "description": "Write the suggestions into the brief (fields the user set are kept).",
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  {
    "name": "storyboard_get",
    "command": "ck storyboard get",
    "description": "Storyboard checkpoint: one still per scene as a sheet shown in the studio. When the brief's checkpoints include storyboard, wait (ck wait) for the user's confirm before building the passes.",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    }
  },
  {
    "name": "history",
    "command": "ck history",
    "description": "Recent revisions in short, newest first: rev, author, label, layers touched.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Newest revisions to list (default 10, at most 50).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "type": "object"
    }
  },
  {
    "name": "branch_save",
    "command": "ck branch save",
    "description": "Save the current project content as a named branch (replaces a save of that name).",
    "cap": 2048,
    "inputSchema": {
      "$defs": {
        "Author": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "voice"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "author": {
          "description": "Who switches: the agent (default) or the human (the studio).",
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "branch_list",
    "command": "ck branch list",
    "description": "Saved branches with the revision each was saved at.",
    "cap": 2048,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "branch_switch",
    "command": "ck branch switch",
    "description": "Make the project equal a saved branch, as one undoable revision.",
    "cap": 2048,
    "inputSchema": {
      "$defs": {
        "Author": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "voice"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "author": {
          "description": "Who switches: the agent (default) or the human (the studio).",
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "variants",
    "command": "ck variants",
    "description": "Token-only variants: one still per look (2 or 3) at a frame, rendered by the worker; pick one with look_apply.",
    "cap": 2048,
    "inputSchema": {
      "required": [
        "looks"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "looks": {
          "description": "Two or three look ids.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frame": {
          "description": "Timeline frame to compare at (default the middle).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    }
  },
  {
    "name": "export",
    "command": "ck export",
    "description": "Export the project to MP4 (fast ffmpeg path or render worker): preset source, youtube, tiktok, reels or shorts; normalized to -14 LUFS, -1 dBTP and measured. queue: true returns a job at once; follow it with jobs.",
    "cap": 1024,
    "inputSchema": {
      "$defs": {
        "ExportFormat": {
          "description": "What `export` writes (spec 8.6).",
          "oneOf": [
            {
              "description": "The video (fast path or render worker).",
              "type": "string",
              "const": "mp4"
            },
            {
              "description": "OpenTimelineIO timeline.",
              "type": "string",
              "const": "otio"
            },
            {
              "description": "SRT subtitles from real word timing.",
              "type": "string",
              "const": "srt"
            }
          ]
        },
        "Preset": {
          "oneOf": [
            {
              "description": "The project's own frame size.",
              "type": "string",
              "const": "source"
            },
            {
              "description": "1920x1080.",
              "type": "string",
              "const": "youtube"
            },
            {
              "description": "1080x1920.",
              "type": "string",
              "const": "tiktok"
            },
            {
              "description": "1080x1920.",
              "type": "string",
              "const": "reels"
            },
            {
              "description": "1080x1920.",
              "type": "string",
              "const": "shorts"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "queue": {
          "description": "Queue the export and return at once with the job.",
          "type": "boolean",
          "default": false
        },
        "format": {
          "description": "mp4 (default), otio or srt; otio and srt answer with the timeline export result.",
          "$ref": "#/$defs/ExportFormat"
        },
        "preset": {
          "$ref": "#/$defs/Preset",
          "default": "source"
        },
        "out": {
          "description": "Output path relative to the project folder; default `exports/<project>-<preset>.mp4`.",
          "type": [
            "string",
            "null"
          ]
        },
        "forceReason": {
          "description": "Export despite failing gates; the reason goes in the export report.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  {
    "name": "jobs",
    "command": "ck jobs",
    "description": "Queued, running and finished exports with progress, newest first.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object",
      "description": "`status` takes no input."
    }
  },
  {
    "name": "voice_script",
    "command": "ck voice script",
    "description": "Split the script into voice slots v1..vn, one per line, with target windows (estimated at 2.5 words/s when absent); replaces the slots and the voice track, keeping takes of unchanged lines.",
    "cap": 4096,
    "inputSchema": {
      "$defs": {
        "ScriptLine": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "window": {
              "description": "Target window; estimated from the word count when absent.",
              "anyOf": [
                {
                  "$ref": "#/$defs/TimeRange"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        },
        "TimeRange": {
          "description": "A half-open time range in seconds, `[start, end)`.",
          "type": "object",
          "properties": {
            "start": {
              "type": "number",
              "format": "double"
            },
            "end": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "start",
            "end"
          ]
        },
        "VoiceMode": {
          "type": "string",
          "enum": [
            "ai",
            "recorded",
            "cloned"
          ]
        }
      },
      "required": [
        "lines"
      ],
      "type": "object",
      "properties": {
        "lines": {
          "description": "One slot per line, in order. Replaces the current slots; a slot whose text and mode are\nunchanged keeps its takes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScriptLine"
          }
        },
        "mode": {
          "description": "Mode for new slots (default ai).",
          "anyOf": [
            {
              "$ref": "#/$defs/VoiceMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "voice_mode",
    "command": "ck voice mode",
    "description": "Switch a voice slot between ai, recorded and cloned; takes are kept.",
    "cap": 1024,
    "inputSchema": {
      "$defs": {
        "VoiceMode": {
          "type": "string",
          "enum": [
            "ai",
            "recorded",
            "cloned"
          ]
        },
        "Author": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "voice"
          ]
        }
      },
      "required": [
        "slot",
        "mode"
      ],
      "type": "object",
      "properties": {
        "slot": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/VoiceMode"
        },
        "author": {
          "description": "Who switches it: the agent (default) or the human (the studio badge).",
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "voice_speak",
    "command": "ck voice speak",
    "description": "Generate speech for an ai or cloned slot (cached by text and voice); the take is trimmed, normalized and fit to the window. placeholder=true means no audio could be made: the studio plays a labeled browser voice.",
    "cap": 1024,
    "inputSchema": {
      "required": [
        "slot"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "slot": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "voice_clone",
    "command": "ck voice clone",
    "description": "Clone the speaker's voice from a take recorded in the studio that the user consented to (default the active take); the slot becomes cloned. Uploaded or generated audio is refused.",
    "cap": 1024,
    "inputSchema": {
      "required": [
        "slot"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "slot": {
          "type": "string"
        },
        "take": {
          "description": "Take to clone from; default the slot's active take.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  {
    "name": "voice_captions",
    "command": "ck voice captions",
    "description": "Captions from each slot's active take with its real word timing (transcribed once per take); one caption item per slot follows its voice item. Slots without a take are listed in skipped.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    }
  },
  {
    "name": "ask",
    "command": "ck ask",
    "description": "Ask the user a question in the studio (up to 6 options; they may also type or speak an answer) and block up to 25 s. answered=false: call again with the id.",
    "cap": 1024,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "description": "The question; omit it with `id` to keep waiting on an earlier one.",
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "id": {
          "description": "Keep waiting for the answer to this earlier question.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeoutSecs": {
          "description": "Seconds to block (default 20, at most 25); 0 checks once.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "type": "object"
    }
  },
  {
    "name": "context",
    "command": "ck context",
    "description": "What the user points at in the studio: selected layer, hovered element, playhead, loop range and open comments. Call it first when the user says this, here or that.",
    "cap": 1536,
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    }
  },
  {
    "name": "comments_list",
    "command": "ck comments list",
    "description": "The send bundle: open and working comments (all with all=true) with anchors, declared scope and last reply, plus the anchored layers in short.",
    "cap": 8192,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "description": "Include resolved comments.",
          "type": "boolean",
          "default": false
        }
      },
      "type": "object"
    }
  },
  {
    "name": "comments_add",
    "command": "ck comments add",
    "description": "Add a comment anchored to a moment (tStart), range (tStart, tEnd), layer (layerId) or element (layerId, propPath); use it to flag an uncertainty for the user.",
    "cap": 2048,
    "inputSchema": {
      "$defs": {
        "Anchor": {
          "description": "Where a comment points: a time range, a layer, a property and/or a point on the frame.",
          "type": "object",
          "properties": {
            "tStart": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "tEnd": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "layerId": {
              "type": [
                "string",
                "null"
              ]
            },
            "propPath": {
              "type": [
                "string",
                "null"
              ]
            },
            "point": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Point"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "Point": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "format": "double"
            },
            "y": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "x",
            "y"
          ]
        },
        "Author": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "voice"
          ]
        }
      },
      "required": [
        "text"
      ],
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor",
          "default": {}
        },
        "author": {
          "description": "Who writes it: the agent (uncertainties) or the human (the studio). Default agent.",
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "comments_reply",
    "command": "ck comments reply",
    "description": "Reply to a comment. An agent reply on an open comment starts work on it; scope lists the layers you will change besides the anchored one (others are refused with E_SCOPE until you resolve).",
    "cap": 2048,
    "inputSchema": {
      "$defs": {
        "Author": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "voice"
          ]
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "scope": {
          "description": "Layers the agent will change besides the anchored one (replaces the declared scope).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "comments_resolve",
    "command": "ck comments resolve",
    "description": "Resolve a comment, with an optional closing reply; returns the layers changed since it was made.",
    "cap": 2048,
    "inputSchema": {
      "$defs": {
        "Author": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "voice"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "description": "Optional closing reply.",
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "wait",
    "command": "ck wait",
    "description": "Block until the user changes something after `since` (comments, brief edits, confirmations, layer edits), at most 25 s. Returns events oldest first; empty on timeout. Call again with since = the returned rev.",
    "cap": 4096,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "Report revisions after this rev (from `handoff` or the last `wait`); omitted means the\ncurrent rev, so only new changes count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "timeoutSecs": {
          "description": "Seconds to block (default 20, at most 25); 0 checks once.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "type": "object"
    }
  }
]

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'/home/sanidhya/Desktop/Hackcbs-Project/.codex/hooks/guard-edits.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'/home/sanidhya/Desktop/Hackcbs-Project/.codex/hooks/guard-bash.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'/home/sanidhya/Desktop/Hackcbs-Project/.codex/hooks/format-file.sh'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/sanidhya/Desktop/Hackcbs-Project/.codex/hooks/stop-check.sh'",
            "timeout": 300
          }
        ]
      }
    ]
  }
}

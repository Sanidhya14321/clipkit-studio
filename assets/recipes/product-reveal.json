{
  "id": "product-reveal",
  "name": "Product reveal",
  "description": "A screenshot or screen recording rises in a device frame, with the product name beside it.",
  "useWhen": "Showing the product itself for the first time.",
  "tags": ["product", "device", "screenshot", "reveal", "demo"],
  "duration": { "default": 4.0, "min": 2.5, "max": 8.0 },
  "slots": [
    { "name": "media", "kind": "source", "required": true, "description": "Source id of the screenshot or screen recording." },
    { "name": "name", "kind": "text", "required": true, "description": "Product name.", "maxChars": 32 },
    { "name": "tagline", "kind": "text", "required": false, "description": "One line on what it does.", "maxChars": 60 }
  ],
  "layers": [
    {
      "name": "backdrop",
      "purpose": "Background behind the device",
      "track": "video",
      "pass": "structure",
      "clip": "backdrop",
      "start": 0.0,
      "end": 1.0,
      "props": { "color": "$colors.background", "accent": "$colors.accent" },
      "briefDeps": ["look", "aspect"]
    },
    {
      "name": "device",
      "purpose": "The product in a device frame",
      "track": "overlay",
      "pass": "graphicsMotion",
      "clip": "device-frame",
      "start": 0.0,
      "end": 1.0,
      "props": { "source": "{media}", "radius": "$size.radius", "easing": "$motion.enterEasing" },
      "briefDeps": ["platform", "aspect"]
    },
    {
      "name": "title",
      "purpose": "Product name and tagline",
      "track": "overlay",
      "pass": "text",
      "clip": "kinetic-text",
      "start": 0.2,
      "end": 1.0,
      "props": {
        "text": "{name}",
        "subtitle": "{tagline}",
        "font": "$fonts.display",
        "color": "$colors.text",
        "stagger": "$motion.stagger"
      },
      "briefDeps": ["goal", "look"]
    }
  ]
}

{
  "id": "talking-head",
  "name": "Talking head with lower third",
  "description": "A speaker clip fills the frame and a lower third names them.",
  "useWhen": "A person speaks to camera and the viewer needs to know who they are.",
  "tags": ["speaker", "interview", "lower third", "name"],
  "duration": { "default": 6.0, "min": 3.0, "max": 30.0 },
  "slots": [
    { "name": "media", "kind": "source", "required": true, "description": "Source id of the speaker clip." },
    { "name": "speaker", "kind": "text", "required": true, "description": "Speaker name.", "maxChars": 40 },
    { "name": "role", "kind": "text", "required": false, "description": "Role or title.", "maxChars": 48 }
  ],
  "layers": [
    {
      "name": "speaker",
      "purpose": "The speaker clip, full frame",
      "track": "video",
      "pass": "structure",
      "clip": "backdrop",
      "start": 0.0,
      "end": 1.0,
      "props": { "source": "{media}", "color": "$colors.background" },
      "briefDeps": ["aspect"]
    },
    {
      "name": "lower-third",
      "purpose": "Name and role in the lower third",
      "track": "overlay",
      "pass": "graphicsMotion",
      "clip": "lower-third",
      "start": 0.08,
      "end": 0.6,
      "props": {
        "name": "{speaker}",
        "role": "{role}",
        "font": "$fonts.text",
        "color": "$colors.accentText",
        "panel": "$colors.accent",
        "radius": "$size.radius",
        "enter": "$motion.enterEasing",
        "exit": "$motion.exitEasing"
      },
      "briefDeps": ["platform", "look"]
    }
  ]
}
